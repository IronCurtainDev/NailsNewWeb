px\">Preferred Time *</label><select class=\"input-luxury\" style=\"border-radius:8px;cursor:pointer;appearance:auto\"><option value=\"10:00 AM\" selected=\"\">10:00 AM</option><option value=\"11:00 AM\">11:00 AM</option><option value=\"12:00 PM\">12:00 PM</option><option value=\"1:00 PM\">1:00 PM</option><option value=\"2:00 PM\">2:00 PM</option><option value=\"3:00 PM\">3:00 PM</option><option value=\"4:00 PM\">4:00 PM</option><option value=\"5:00 PM\">5:00 PM</option><option value=\"6:00 PM\">6:00 PM</option></select></div></div><div style=\"margin-bottom:32px\"><label class=\"font-dm\" style=\"display:block;font-size:10px;letter-spacing:0.2em;text-transform:uppercase;font-weight:600;color:var(--text-muted);margin-bottom:8px\">Design Inspo / Notes</label><textarea rows=\"3\" placeholder=\"Tell Che your vision — color, shape, design references, etc.\" class=\"input-luxury\" style=\"border-radius:8px;resize:vertical\"></textarea></div><button type=\"submit\" class=\"btn-gold shimmer-hover\" style=\"width:100%;font-size:11px;letter-spacing:0.2em;position:relative\">Request Appointment ✦</button><style>@keyframes spin { to { transform: rotate(360deg); } }</style><p class=\"font-dm text-center\" style=\"font-size:11px;color:var(--text-light);margin-top:16px;line-height:1.6\">Che will confirm within 24 hours · No payment taken online</p></form></div></div></div></section><section style=\"background:var(--noir);border-top:1px solid rgba(201,168,76,0.2);padding:80px 32px;text-align:center;position:relative;overflow:hidden\"><div aria-hidden=\"true\" style=\"position:absolute;inset:0;background:radial-gradient(ellipse at center, rgba(201,168,76,0.08) 0%, transparent 70%);pointer-events:none\"></div><div style=\"position:relative;max-width:640px;margin:0 auto\"><div class=\"font-dm inline-block\" style=\"font-size:10px;letter-spacing:0.3em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:20px\">✦ Don&#x27;t Wait ✦</div><h2 class=\"font-display\" style=\"font-size:clamp(36px, 5vw, 64px);font-weight:400;color:var(--ivory);line-height:1.05;letter-spacing:-0.02em;margin-bottom:24px\">Slots fill fast.<br/><em style=\"font-style:italic;color:var(--gold-light)\">Book yours today.</em></h2><p class=\"font-dm\" style=\"font-size:15px;color:rgba(250,248,245,0.6);font-weight:300;line-height:1.75;margin-bottom:40px\">Auréva is a one-artist studio with limited weekly appointments. Reserve your date before it&#x27;s gone.</p><div class=\"flex flex-wrap justify-center gap-4\"><a href=\"#booking\" class=\"btn-gold shimmer-hover\">Book Now ✦</a><a href=\"https://www.instagram.com/aureva_nails_by_che\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn-outline\" style=\"color:var(--ivory);border-color:rgba(201,168,76,0.4)\">View Instagram  ↗</a></div></div></section><footer style=\"background:var(--noir-deep);border-top:1px solid rgba(201,168,76,0.15);padding:60px 32px 40px\"><div class=\"max-w-7xl mx-auto\"><div style=\"display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:48px;margin-bottom:48px;padding-bottom:48px;border-bottom:1px solid rgba(201,168,76,0.12)\" class=\"flex flex-col sm:grid\"><div><div class=\"flex items-center gap-3\" style=\"margin-bottom:20px\"><div style=\"width:44px;height:44px;border-radius:50%;border:1.5px solid rgba(201,168,76,0.3);overflow:hidden;padding:3px\"><img alt=\"Auréva\" loading=\"lazy\" width=\"38\" height=\"38\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogo.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo.png&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.png&amp;w=96&amp;q=75\"/></div><div><div class=\"font-display\" style=\"font-size:18px;color:var(--ivory);letter-spacing:-0.01em\">AURÉVA NAILS</div><div class=\"font-dm\" style=\"font-size:8px;letter-spacing:0.28em;text-transform:uppercase;color:var(--gold);font-weight:600\">BY CHE</div></div></div><p class=\"font-dm\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;line-height:1.75;max-width:240px\">Bespoke gel nails, extensions &amp; nail art in a private studio setting. Every set is custom-crafted by Che.</p></div><div><div class=\"font-dm\" style=\"font-size:10px;letter-spacing:0.24em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:20px\">Services</div><a href=\"#services\" class=\"font-dm block\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px;text-decoration:none;transition:color 0.2s\">Gel Manicure</a><a href=\"#services\" class=\"font-dm block\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px;text-decoration:none;transition:color 0.2s\">Gel Extensions</a><a href=\"#services\" class=\"font-dm block\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px;text-decoration:none;transition:color 0.2s\">Bridal Suite</a><a href=\"#services\" class=\"font-dm block\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px;text-decoration:none;transition:color 0.2s\">Press-On Nails</a></div><div><div class=\"font-dm\" style=\"font-size:10px;letter-spacing:0.24em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:20px\">Studio Info</div><div class=\"font-dm\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px\">By Appointment Only</div><div class=\"font-dm\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px\">Private Studio</div><div class=\"font-dm\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px\">Mon–Sat: 10am–7pm</div><div class=\"font-dm\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px\">Sun: Closed</div></div><div><div class=\"font-dm\" style=\"font-size:10px;letter-spacing:0.24em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:20px\">Connect</div><a href=\"https://www.instagram.com/aureva_nails_by_che\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-dm flex items-center gap-2\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px;text-decoration:none;transition:color 0.2s\">Instagram ↗</a><a href=\"#booking\" class=\"font-dm block\" style=\"font-size:13px;color:rgba(250,248,245,0.45);font-weight:300;margin-bottom:10px;text-decoration:none;transition:color 0.2s\">Book Appointment</a></div></div><div class=\"flex flex-wrap items-center justify-between gap-4\"><p class=\"font-dm\" style=\"font-size:11px;color:rgba(250,248,245,0.3);letter-spacing:0.06em\">© <!-- -->2026<!-- --> Auréva Nails by Che. All rights reserved.</p><div class=\"flex items-center gap-4\"><a href=\"/admin\" class=\"font-dm\" style=\"font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(201, 168, 76, 0.6);text-decoration:none;transition:color 0.2s ease\">✦ Studio Admin</a><p class=\"font-dm\" style=\"font-size:11px;color:rgba(250,248,245,0.3);letter-spacing:0.06em\">Crafted with love ✦</p></div></div></div></footer></div><!--$--><!--/$--><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\"]\\n4:I[47257,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"ClientPageRoot\\\"]\\n5:I[52683,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/10pgdf8ggv440.js\\\",\\\"/_next/static/chunks/3xt6wd658x7-5.js\\\"],\\\"default\\\"]\\n8:I[97367,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"OutletBoundary\\\"]\\n9:\\\"$Sreact.suspense\\\"\\nb:I[97367,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"ViewportBoundary\\\"]\\nd:I[97367,[\\\"/_n