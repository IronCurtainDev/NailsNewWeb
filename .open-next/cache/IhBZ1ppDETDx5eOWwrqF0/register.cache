0.25);border-radius:20px;padding:48px 40px;box-shadow:0 40px 80px -20px rgba(0,0,0,0.7), 0 0 0 1px rgba(201,168,76,0.1);backdrop-filter:blur(20px);margin:24px 0\"><div style=\"text-align:center;margin-bottom:32px\"><a style=\"text-decoration:none;display:inline-flex;flex-direction:column;align-items:center;gap:12px\" href=\"/\"><div style=\"width:60px;height:60px;border-radius:50%;border:1.5px solid rgba(201,168,76,0.5);background:white;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:4px\"><img alt=\"Auréva Nails\" loading=\"lazy\" width=\"52\" height=\"52\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogo.png&amp;w=64&amp;q=75 1x, /_next/image?url=%2Flogo.png&amp;w=128&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.png&amp;w=128&amp;q=75\"/></div><div><span class=\"font-display block\" style=\"font-size:20px;color:var(--ivory);letter-spacing:-0.01em;line-height:1.1\">AURÉVA NAILS</span><span class=\"font-dm block\" style=\"font-size:9px;letter-spacing:0.32em;color:var(--gold);text-transform:uppercase;font-weight:600\">BY CHE</span></div></a></div><h1 class=\"font-display\" style=\"font-size:28px;color:var(--ivory);margin-bottom:8px;text-align:center\">Create your account</h1><p class=\"font-dm\" style=\"font-size:13px;color:rgba(250,248,245,0.5);text-align:center;margin-bottom:32px;letter-spacing:0.02em\">Book appointments &amp; track your orders in one place</p><form style=\"display:flex;flex-direction:column;gap:16px\"><div><label style=\"font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(250,248,245,0.4);display:block;margin-bottom:8px;font-family:DM Sans, sans-serif\">Full Name</label><input id=\"register-name\" type=\"text\" required=\"\" placeholder=\"Your full name\" style=\"width:100%;padding:14px 16px;border-radius:10px;background:rgba(250,248,245,0.05);border:1px solid rgba(201,168,76,0.2);color:var(--ivory);font-size:14px;font-family:DM Sans, sans-serif;outline:none;transition:border-color 0.2s\" value=\"\"/></div><div><label style=\"font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(250,248,245,0.4);display:block;margin-bottom:8px;font-family:DM Sans, sans-serif\">Email Address</label><input id=\"register-email\" type=\"email\" required=\"\" placeholder=\"your@email.com\" style=\"width:100%;padding:14px 16px;border-radius:10px;background:rgba(250,248,245,0.05);border:1px solid rgba(201,168,76,0.2);color:var(--ivory);font-size:14px;font-family:DM Sans, sans-serif;outline:none;transition:border-color 0.2s\" value=\"\"/></div><div><label style=\"font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(250,248,245,0.4);display:block;margin-bottom:8px;font-family:DM Sans, sans-serif\">WhatsApp / Phone</label><input id=\"register-phone\" type=\"tel\" required=\"\" placeholder=\"+91 98765 43210\" style=\"width:100%;padding:14px 16px;border-radius:10px;background:rgba(250,248,245,0.05);border:1px solid rgba(201,168,76,0.2);color:var(--ivory);font-size:14px;font-family:DM Sans, sans-serif;outline:none;transition:border-color 0.2s\" value=\"\"/></div><div><label style=\"font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(250,248,245,0.4);display:block;margin-bottom:8px;font-family:DM Sans, sans-serif\">Password</label><div style=\"position:relative\"><input id=\"register-password\" type=\"password\" required=\"\" placeholder=\"Minimum 6 characters\" style=\"width:100%;padding:14px 16px;border-radius:10px;background:rgba(250,248,245,0.05);border:1px solid rgba(201,168,76,0.2);color:var(--ivory);font-size:14px;font-family:DM Sans, sans-serif;outline:none;transition:border-color 0.2s;padding-right:44px\" value=\"\"/><button type=\"button\" style=\"position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:rgba(250,248,245,0.4);font-size:16px;padding:4px\">👁</button></div></div><div><label style=\"font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(250,248,245,0.4);display:block;margin-bottom:8px;font-family:DM Sans, sans-serif\">Confirm Password</label><input id=\"register-confirm-password\" type=\"password\" required=\"\" placeholder=\"Re-enter your password\" style=\"width:100%;padding:14px 16px;border-radius:10px;background:rgba(250,248,245,0.05);border:1px solid rgba(201,168,76,0.2);color:var(--ivory);font-size:14px;font-family:DM Sans, sans-serif;outline:none;transition:border-color 0.2s\" value=\"\"/></div><button id=\"register-submit\" type=\"submit\" style=\"margin-top:8px;width:100%;padding:16px;background:linear-gradient(135deg, #C9A84C 0%, #E8D28A 50%, #C9A84C 100%);border:none;border-radius:10px;color:var(--noir);font-family:DM Sans, sans-serif;font-size:13px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;cursor:pointer;transition:all 0.25s ease;box-shadow:0 8px 24px -4px rgba(201,168,76,0.35)\">Create Account ✦</button></form><div style=\"display:flex;align-items:center;gap:12px;margin:28px 0\"><div style=\"flex:1;height:1px;background:rgba(201,168,76,0.15)\"></div><span class=\"font-dm\" style=\"font-size:11px;color:rgba(250,248,245,0.3);letter-spacing:0.08em\">OR</span><div style=\"flex:1;height:1px;background:rgba(201,168,76,0.15)\"></div></div><p class=\"font-dm\" style=\"text-align:center;font-size:13px;color:rgba(250,248,245,0.4)\">Already have an account?<!-- --> <a style=\"color:var(--gold);text-decoration:none;font-weight:500\" href=\"/login\">Sign in →</a></p><p class=\"font-dm\" style=\"text-align:center;font-size:13px;color:rgba(250,248,245,0.3);margin-top:12px\"><a style=\"color:rgba(201,168,76,0.5);text-decoration:none\" href=\"/\">← Back to studio</a></p></div></div><!--$--><!--/$--><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39